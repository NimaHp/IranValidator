<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Proves that all six packages compile, install and run on the lowest
         supported TFM. Built by CI on the real net8.0 runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IranValidator.Core\IranValidator.Core.csproj" />
    <ProjectReference Include="..\..\src\IranValidator.DataAnnotations\IranValidator.DataAnnotations.csproj" />
    <ProjectReference Include="..\..\src\IranValidator.FluentValidation\IranValidator.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\IranValidator.Localization\IranValidator.Localization.csproj" />
    <ProjectReference Include="..\..\src\IranValidator.MinimalApis\IranValidator.MinimalApis.csproj" />
    <ProjectReference Include="..\..\src\IranValidator.AspNetCore\IranValidator.AspNetCore.csproj" />
  </ItemGroup>

</Project>
